{
    "name": "frontend",
    "version": "0.1.13",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite --host 127.0.0.1 --port 5301 --strictPort",
        "typecheck": "tsc --noEmit",
        "build": "tsc --noEmit && vite build",
        "test": "vitest run && playwright test",
        "lint": "cd ../.. && oxlint packages/ui/src apps/frontend/src apps/frontend/tests apps/frontend/scripts apps/frontend/vite.config.ts apps/frontend/playwright.config.ts",
        "format:check": "prettier --check --config .prettierrc.json . ../../packages/ui/src/shell.tsx ../../packages/ui/src/page.tsx ../../packages/ui/src/styles.css",
        "test:unit": "vitest run",
        "test:e2e": "playwright test",
        "check:size": "node scripts/check-size.mjs",
        "package": "pnpm build && pnpm check:size && python3 ../../scripts/package.py frontend"
    },
    "dependencies": {
        "@cloudflare/kumo": "2.18.1",
        "@fontsource-variable/inter": "^5.3.0",
        "@nezha-kumo/ui": "workspace:*",
        "@phosphor-icons/react": "2.1.10",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "i18next": "^25.10.10",
        "react-i18next": "^16.6.6"
    },
    "devDependencies": {
        "@playwright/test": "^1.64.1",
        "@tailwindcss/vite": "^4.3.3",
        "@trivago/prettier-plugin-sort-imports": "^6.0.2",
        "@types/node": "^26.6.5",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.1.2",
        "oxlint": "1.89.0",
        "prettier": "^3.10.1",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "tailwindcss": "4.3.3",
        "typescript": "~7.0.2",
        "vite": "^8.3.4",
        "vitest": "^4.1.0"
    },
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/zhdsmy/nezha-kumo-theme.git",
        "directory": "apps/frontend"
    }
}
