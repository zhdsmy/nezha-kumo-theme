{
    "compilerOptions": {
        "target": "ES2022",
        "lib": ["ES2023", "DOM", "DOM.Iterable"],
        "module": "ESNext",
        "moduleResolution": "bundler",
        "jsx": "react-jsx",
        "strict": true,
        "noEmit": true,
        "skipLibCheck": true,
        "verbatimModuleSyntax": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "types": ["vite/client", "node"],
        "paths": {
            "@/*": ["./src/*"]
        },
        "ignoreDeprecations": "6.0"
    },
    "include": ["src", "tests", "vite.config.ts", "playwright.config.ts"]
}
